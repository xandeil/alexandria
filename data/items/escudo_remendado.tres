[resource]
script = ExtResource("1_script")
id = "escudo_remendado"
display_name = "Escudo Remendado"
description = "Tampa de aço com o brasão raspado a faca. Os soldados da Cidade carregam iguais; este é o único que ninguém veio buscar.
Mão esquerda: segure a defesa para erguê-lo. Segura golpes pela frente, mas cada golpe custa estamina — sem estamina, a guarda quebra. O grito e as ondas no chão passam por cima dele."
