[gd_resource type="Resource" script_class="BossData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/bosses/boss_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "cavaleiro"
display_name = "O Cavaleiro Desolado"
title = "Guardião do Núcleo"
sin = "—"
sin_meaning = "Proteção que virou prisão"
race = "O que restou do Cientista da Gravidade"
attribute = "Gravidade"
area = "O Núcleo"
scaling = "—"
suggested_order = "Final"
memory_reward = 0
implemented = true
unique_mechanic = "Fica sempre entre você e a mulher do núcleo. Gravidade: puxa, empurra e faz chover pedra. Ao vencê-lo, a escolha: Proteger (Continuidade) ou Destruir (Ruptura)."
phases = Array[String](["Fase 1 — O Guardião: espadão em três tempos, guarda que apara de frente e a gravidade que puxa você para perto.", "Fase 2 — A Promessa (metade da vida): pedras caem do alto, um anel que empurra e, ajoelhado, ele renova o elo com ela — fique no caminho da luz para cortar a cura."])
history = "Não é um vilão clássico. Parece frustrado por não ter cumprido seu objetivo, mas o objetivo nunca foi conquista: foi proteção. Enquanto a mulher ligada ao núcleo existir, a ilha flutua e o ciclo continua."
meaning = "Algumas coisas sobrevivem, mas nunca vivem. / Libertar algo pode ser o mesmo que destruí-lo."
