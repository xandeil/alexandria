[resource]
script = ExtResource("1_script")
id = "mae_faminta"
display_name = "A Mãe Faminta"
title = "Inimiga das Raízes da Fome"
sin = "Mini-chefe"
sin_meaning = "Preguiça"
race = "Planta"
attribute = "Sono"
area = "Raízes da Fome"
scaling = "—"
suggested_order = "Raízes — na Varanda"
memory_reward = 550
implemented = true
unique_mechanic = "Planta enorme cercada de Flores de Pólen. Ensina a Barra de Sonolência antes de Nyssa: quem dorme perto dela leva o cipó pesado."
phases = Array[String](["Cipó (linha que trava), chuva de esporos e o florescer: um anel de sono enorme. Faz brotar flores."])
history = "A mesma canção da Mãe dos Esporos. Aqui embaixo, ela termina diferente."
meaning = "Atacar espanta o sono: a luta obriga o jogador a ser agressivo."
