script = ExtResource("1_script")
id = "aldir"
display_name = "Aldir Cornélios"
title = "O Detentor do Caos"
sin = "Ira"
sin_meaning = "Impotência"
race = "Humano"
attribute = "Força"
area = "Cidade Estilhaçada"
scaling = "Força"
suggested_order = "1ª"
memory_reward = 1200
