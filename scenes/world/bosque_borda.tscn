exits = Array[Dictionary]([{"cell": Vector2i(10, 1), "scene": "res://scenes/world/dominio_galeria.tscn", "spawn": "galho", "requires": "flag:atalho_galho", "locked_dialogue": "galho_trancado", "arrival": "galho"}, {"cell": Vector2i(46, 12), "scene": "res://scenes/world/bosque_dormitorio.tscn", "spawn": "raiz", "arrival": "raiz", "opens": "atalho_raiz"}])
exit2_scene = "res://scenes/world/arena_nyssa.tscn"
