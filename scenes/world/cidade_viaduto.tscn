[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/world/level.gd" id="1_level"]
[ext_resource type="TileSet" path="res://assets/tiles/cidade_tileset.tres" id="2_tiles"]
[ext_resource type="Script" path="res://scripts/world/game_camera.gd" id="3_camera"]

[node name="Viaduto" type="Node2D"]
script = ExtResource("1_level")
layout_file = "res://levels/cidade_viaduto.txt"
area_name = "Viaduto Partido"
area_subtitle = "Metade da ponte caiu com a ilha. A outra metade espera."
theme = "cidade"
ambience = &"amb_city"
darkness = Color(0.9, 0.82, 0.8, 1)
outdoor = true
exit_scene = "res://scenes/world/cidade_quartel.tscn"
exit_spawn = "lateral"
exits = Array[Dictionary]([{"cell": Vector2i(57, 5), "scene": "res://scenes/world/montanha.tscn", "spawn": "porta", "arrival": "escalada"}, {"cell": Vector2i(55, 10), "scene": "res://scenes/world/cidade_quartel.tscn", "spawn": "atalho", "arrival": "portao_atalho", "opens": "atalho_viaduto"}])
collapse_fights = Array[Dictionary]([{"boss": "couraca", "rect": Rect2i(14, 5, 30, 3), "interval": 2.6, "max": 10}])

[node name="CanvasModulate" type="CanvasModulate" parent="."]

[node name="Floor" type="TileMapLayer" parent="."]
z_index = -10
tile_set = ExtResource("2_tiles")

[node name="Walls" type="TileMapLayer" parent="."]
tile_set = ExtResource("2_tiles")

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Camera" type="Camera2D" parent="."]
script = ExtResource("3_camera")
